# ============================================================
#  E-Commerce Backend — Environment Variables Template
#  Copy this to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ----- MySQL Database -----
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ----- Redis (Upstash — hostname only, NO https://) -----
REDIS_endpoint=your-host.upstash.io
REDIS_PORT=6379
REDIS_token=your_upstash_redis_token

# ----- Cloudinary -----
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# ----- JWT (minimum 64 chars — generate: openssl rand -hex 64) -----
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production_min_64_chars

# ----- Admin Bootstrap (auto-created on first run) -----
ADMIN_EMAIL=admin@shopease.com
ADMIN_PASSWORD=Admin@1234

# ----- Mail (Gmail SMTP — use an App Password, NOT your account password) -----
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ----- Razorpay -----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ----- CORS (comma-separated, no trailing slash) -----
ALLOWED_ORIGINS=http://localhost:5173
